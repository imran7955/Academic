@model IEnumerable<LmsProject.Web.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "System Identity Index";
}

<div class="container mt-4">
    <div class="card shadow border-0 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold m-0 text-dark font-monospace">System Users Directory</h3>
                <p class="text-muted small m-0">Review, update security clearance profiles, override passwords, or provision brand-new user accounts.</p>
            </div>
        </div>

        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <ul class="nav nav-pills mb-4 bg-light p-2 rounded-3 border" id="userRoleTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold px-4 rounded-2" id="all-tab" data-bs-toggle="tab" data-bs-target="#all-panel" type="button" role="tab">All Directory</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold px-4 rounded-2" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin-panel" type="button" role="tab">👑 Administrators</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold px-4 rounded-2" id="instructor-tab" data-bs-toggle="tab" data-bs-target="#instructor-panel" type="button" role="tab">🎓 Instructors</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold px-4 rounded-2" id="student-tab" data-bs-toggle="tab" data-bs-target="#student-panel" type="button" role="tab">👥 General Users</button>
            </li>
            <li class="nav-item ms-auto" role="presentation">
                <button class="nav-link fw-bold px-4 rounded-2 text-white" id="create-tab" data-bs-toggle="tab" data-bs-target="#create-panel" type="button" role="tab" style="background-color: #d55744;">➕ Create User</button>
            </li>
        </ul>

        <div class="tab-content" id="userRoleTabsContent">

            <div class="tab-pane fade show active" id="all-panel" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary font-monospace small">
                            <tr>
                                <th>Account Username / Email Address</th>
                                <th>Current Active RBAC Role Privilege</th>
                                <th class="text-end">Administrative Tools</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                string badgeColor = user.Role == "Admin" ? "bg-dark text-white" : (user.Role == "Instructor" ? "bg-primary text-white" : "bg-secondary text-white");
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-3 border text-center font-monospace" style="width: 40px; height: 40px; line-height: 22px;">U</div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@user.Username</span>
                                                <small class="text-muted font-monospace" style="font-size:0.8rem;">ID: @user.UserId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @badgeColor fw-semibold px-3 py-2">@user.Role</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark fw-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#editModal-@user.UserId">
                                            ⚙ Modify Account
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="admin-panel" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary font-monospace small">
                            <tr>
                                <th>Account Username / Email Address</th>
                                <th>Current Active RBAC Role Privilege</th>
                                <th class="text-end">Administrative Tools</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Where(u => u.Role == "Admin"))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-3 border text-center font-monospace" style="width: 40px; height: 40px; line-height: 22px;">U</div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@user.Username</span>
                                                <small class="text-muted font-monospace" style="font-size:0.8rem;">ID: @user.UserId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-dark text-white fw-semibold px-3 py-2">@user.Role</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark fw-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#editModal-@user.UserId">
                                            ⚙ Modify Account
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="instructor-panel" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary font-monospace small">
                            <tr>
                                <th>Account Username / Email Address</th>
                                <th>Current Active RBAC Role Privilege</th>
                                <th class="text-end">Administrative Tools</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Where(u => u.Role == "Instructor"))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-3 border text-center font-monospace" style="width: 40px; height: 40px; line-height: 22px;">U</div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@user.Username</span>
                                                <small class="text-muted font-monospace" style="font-size:0.8rem;">ID: @user.UserId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary text-white fw-semibold px-3 py-2">@user.Role</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark fw-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#editModal-@user.UserId">
                                            ⚙ Modify Account
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="student-panel" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary font-monospace small">
                            <tr>
                                <th>Account Username / Email Address</th>
                                <th>Current Active RBAC Role Privilege</th>
                                <th class="text-end">Administrative Tools</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Where(u => u.Role != "Admin" && u.Role != "Instructor"))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-3 border text-center font-monospace" style="width: 40px; height: 40px; line-height: 22px;">U</div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@user.Username</span>
                                                <small class="text-muted font-monospace" style="font-size:0.8rem;">ID: @user.UserId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary text-white fw-semibold px-3 py-2">@user.Role</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark fw-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#editModal-@user.UserId">
                                            ⚙ Modify Account
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="create-panel" role="tabpanel">
                <div class="row justify-content-center py-4">
                    <div class="col-md-6">
                        <div class="card border shadow-sm">
                            <div class="card-body p-4">
                                <h4 class="fw-bold text-dark mb-1 font-monospace text-center">Provision Secure User Account</h4>
                                <p class="text-muted small text-center mb-4">Directly registers a new account inside the centralized system database directory.</p>

                                <form asp-action="CreateNewUser" asp-controller="User" method="post">
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted font-monospace">Full Profile Display Name</label>
                                        <input type="text" name="name" class="form-control" placeholder="e.g. Professor Smith (Optional for Students)" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted font-monospace">Primary Account Email Handle</label>
                                        <input type="email" name="email" class="form-control" placeholder="name@lmsdomain.com" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted font-monospace">Account Password</label>
                                        <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label small fw-bold text-muted font-monospace">Assigned Privilege Authorization Group</label>
                                        <select name="targetRole" class="form-select fw-semibold text-dark">
                                            <option value="Student" selected>Student / General User Profile</option>
                                            <option value="Instructor">Instructor (Faculty Privileges)</option>
                                            <option value="Admin">Admin (Global System Supervisor)</option>
                                        </select>
                                    </div>

                                    <button type="submit" class="btn btn-dark w-100 fw-bold py-2 shadow-sm" style="background-color: #d55744; border-color: #d55744;">
                                        🚀 Deploy User Account Record
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="userModalContainer">
    @foreach (var user in Model)
    {
        <div class="modal fade" id="editModal-@user.UserId" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-dark text-white p-3">
                        <h5 class="modal-title fw-bold">Update Core Security Metrics</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="UpdateUserCredentials" asp-controller="User" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.UserId" />

                        <div class="modal-body text-start p-4">
                            <div class="mb-3">
                                <label class="form-label font-monospace small fw-bold text-muted">Primary Email Address Handle</label>
                                <input type="email" name="email" value="@user.Email" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label font-monospace small fw-bold text-muted">Override Account Password</label>
                                <input type="password" name="newPassword" class="form-control" placeholder="Leave blank to maintain current password" />
                                <div class="form-text text-muted small">Only enter a value if you wish to enforce an immediate password reset override.</div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label font-monospace small fw-bold text-muted">Enforce Authorization Group Privilege Level</label>
                                <select name="targetRole" class="form-select fw-semibold">
                                    <option value="Admin" selected="@(user.Role == "Admin")">Admin (System Global Supervisor)</option>
                                    <option value="Instructor" selected="@(user.Role == "Instructor")">Instructor (Faculty Privileges)</option>
                                    <option value="Student" selected="@(user.Role == "Student" || user.Role == "General User")">Student / General User Profile</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer bg-light p-3 border-top-0">
                            <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary fw-bold px-4">Commit Database Overrides</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>