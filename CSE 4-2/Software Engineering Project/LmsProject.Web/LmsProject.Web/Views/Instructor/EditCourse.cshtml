@model LmsProject.Domain.Entities.Course
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Edit Course Space";
    var domains = ViewBag.Domains as List<string> ?? new List<string>();
    var allInstructors = ViewBag.Instructors as List<LmsProject.Domain.Entities.Instructor> ?? new List<LmsProject.Domain.Entities.Instructor>();
    var currentInstructorIds = Model.Instructors != null ? Model.Instructors.Select(i => i.Id).ToHashSet() : new HashSet<int>();
}

<style>
    .workspace-wrapper {
        margin-top: 30px;
        margin-bottom: 60px;
    }

    .custom-nav-tabs .nav-link {
        color: #64748b;
        font-weight: 600;
        border: none;
        padding: 12px 20px;
        transition: all 0.2s ease;
    }

        .custom-nav-tabs .nav-link.active {
            color: #0d6efd;
            background: transparent;
            border-bottom: 3px solid #0d6efd;
        }

    .syllabus-sortable-item {
        background-color: #ffffff;
        border-bottom: 1px solid #e2e8f0 !important;
        transition: background-color 0.2s, box-shadow 0.2s;
        cursor: grab;
    }

        .syllabus-sortable-item:active {
            cursor: grabbing;
        }

        .syllabus-sortable-item.drag-over-active {
            border-top: 2px solid #0d6efd !important;
            background-color: #f0f7ff;
        }

    .item-control-actions {
        opacity: 0;
        transform: translateX(5px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        pointer-events: none;
    }

    .syllabus-sortable-item:hover {
        background-color: #f8fafc;
    }

        .syllabus-sortable-item:hover .item-control-actions {
            opacity: 1;
            transform: translateX(0);
            pointer-events: auto;
        }

    .string-clip {
        display: inline-block;
        max-width: 85%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }
</style>

<div class="container workspace-wrapper" style="max-width: 850px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="text-uppercase tracking-wider font-monospace text-primary fw-bold small">■ Strategic Control Center</span>
            <h2 class="text-dark fw-bold mb-0">Management: @Model.Title</h2>
        </div>
        <a href="@Url.Action("Dashboard", "Instructor")" class="btn btn-outline-secondary fw-bold shadow-sm">← Back to Hub</a>
    </div>

    <ul class="nav nav-tabs custom-nav-tabs mb-4 border-bottom" id="courseManagementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active font-monospace" id="meta-tab" data-bs-toggle="tab" data-bs-target="#metaPanelZone" type="button" role="tab">
                📝 1. Course Information
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link font-monospace" id="syllabus-tab" data-bs-toggle="tab" data-bs-target="#syllabusPanelZone" type="button" role="tab">
                🎥 2. Dynamic Video Materials
            </button>
        </li>
    </ul>

    <div class="tab-content" id="courseManagementTabsContent">

        <div class="tab-pane fade show active" id="metaPanelZone" role="tabpanel">
            <div class="card border shadow-sm rounded-3">
                <div class="card-body p-4">
                    <!-- ADDED: enctype="multipart/form-data" for image uploads -->
                    <form id="courseMetadataForm" method="post" action="@Url.Action("EditCourse", "Instructor", new { id = Model.Id })" onsubmit="return prepareEditDomainPayload(event)" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" id="finalEditDomainValue" name="domain" value="@Model.Domain" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Course Title</label>
                            <input type="text" name="title" value="@Model.Title" class="form-control shadow-sm" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Course Domain Track</label>
                            @if (!domains.Any())
                            {
                                <div class="p-3 border rounded bg-light mb-2">
                                    <small class="text-muted d-block mb-2">💡 Database domain cache profiles are blank. Define custom field below:</small>
                                    <input type="text" id="customEditDomainInputNoDomains" class="form-control" value="@Model.Domain" placeholder="e.g. Computer Science" />
                                </div>
                            }
                            else
                            {
                                <select id="editDomainSelectDropdown" class="form-select shadow-sm" onchange="toggleEditDomainInputFields()">
                                    @foreach (var domain in domains)
                                    {
                                        if (domain == Model.Domain)
                                        {
                                            <option value="@domain" selected>@domain</option>
                                        }
                                        else
                                        {
                                            <option value="@domain">@domain</option>
                                        }
                                    }
                                    <option value="__CUSTOM__">➕ [Add Custom New Domain...]</option>
                                </select>

                                <div id="customEditDomainInputWrapper" class="mt-2 p-3 border rounded bg-light" style="display: none;">
                                    <label class="form-label small fw-bold text-dark">New Domain Title Name</label>
                                    <input type="text" id="customEditDomainInput" class="form-control" placeholder="Type custom domain name here..." />
                                </div>
                            }
                        </div>

                        <!-- ADDED: Course Thumbnail Update Field with Preview -->
                        <div class="mb-4 border rounded p-3 bg-light">
                            <label class="form-label small fw-bold text-secondary">Course Thumbnail Image</label>
                            <input type="file" name="imageFile" id="imageFile" class="form-control shadow-sm mb-2" accept="image/*" />

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="d-flex align-items-center gap-3 mt-3">
                                    <img src="@Model.ImageUrl" alt="Current Thumbnail" style="width: 120px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #ccc;" />
                                    <div>
                                        <span class="d-block text-dark fw-bold small">Current Image Active</span>
                                        <small class="text-muted">Leave the file input blank to preserve this cover.</small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <small class="text-muted d-block mt-1">No cover image currently assigned. Upload one to set a thumbnail.</small>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary">Course Description Overview</label>
                            <textarea name="description" class="form-control shadow-sm" rows="4" placeholder="Provide paragraph description data summarizing content rules...">@Model.Description</textarea>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border border-secondary border-opacity-25 shadow-sm">
                            <label class="form-label small fw-bold text-dark d-block mb-1">Assign Instructors Faculty</label>
                            <input type="text" id="facultyLookupSearchBox" class="form-control form-control-sm mb-3 shadow-sm" placeholder="🔍 Type faculty member name to filter instantly..." onkeyup="filterFacultyListGrid()" />

                            <div class="row row-cols-1 row-cols-sm-2 g-2" id="facultyRowsLayoutContainer" style="max-height: 140px; overflow-y: auto; padding-right: 2px;">
                                @foreach (var inst in allInstructors)
                                {
                                    var isMapped = currentInstructorIds.Contains(inst.Id);
                                    <div class="col faculty-checkbox-wrapper" data-name="@inst.Name.ToLower()">
                                        <div class="form-check p-2 border rounded bg-white h-100" style="transition: border-color 0.2s;">
                                            <input class="form-check-input ms-1 me-2 mt-1" type="checkbox" name="selectedInstructors" value="@inst.Id" id="check_faculty_@inst.Id" @(isMapped ? "checked" : "")>
                                            <label class="form-check-label small text-dark ps-1 string-clip" for="check_faculty_@inst.Id" style="cursor: pointer; user-select: none;">
                                                👤 @inst.Name
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary fw-bold px-4 py-2 shadow-sm">
                            💾 Save Course Details
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="syllabusPanelZone" role="tabpanel">
            <div class="row g-4">

                <div class="col-md-5">
                    <div class="card border shadow-sm rounded-3">
                        <div class="card-header bg-dark text-white fw-bold font-monospace py-3">
                            Stage New Video Link
                        </div>
                        <div class="card-body p-3">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">Material / Lesson Title</label>
                                <input type="text" id="inputMaterialTitle" class="form-control" placeholder="e.g. Backtracking Algorithms" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-secondary">YouTube Reference Link</label>
                                <input type="url" id="inputMaterialUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                            </div>

                            <button type="button" class="btn btn-outline-primary w-100 fw-bold py-2 mb-2" onclick="addMaterialToQueueRow()">
                                ➕ Add Material to Queue
                            </button>
                            <small class="text-muted d-block text-center mt-1" style="font-size:0.75rem;">Items wait in temporary staging space until you save down below.</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="card border shadow-sm rounded-3 h-100 d-flex flex-column">
                        <div class="card-header bg-light fw-bold text-secondary d-flex justify-content-between align-items-center py-3">
                            <span>Track Sequence Management</span>
                            <span class="badge bg-secondary rounded-pill" id="queueCounterBadge">0 Items</span>
                        </div>

                        <div class="card-body p-0 flex-grow-1 overflow-auto" style="min-height: 260px; max-height: 380px;">
                            <div id="emptyQueueNotice" class="text-center py-5 text-muted">
                                <p class="mb-1 fw-bold text-secondary opacity-75">Syllabus Empty</p>
                            </div>

                            <div class="list-group list-group-flush" id="liveVisualStagingQueueHolder">
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top p-3">
                            <button type="button" id="btnSubmitBulkSyllabus" class="btn btn-success px-4 fw-bold w-100 py-2 shadow-sm" onclick="commitBulkStagedSyllabusToDatabase()">
                                💾 Save Syllabus Sequence
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    let materialStagingQueue = [];
    let currentlyDraggedIndex = null;

    document.addEventListener("DOMContentLoaded", function () {
        @if (Model.CourseMaterials != null && Model.CourseMaterials.Any())
        {
                    var sortedExisting = Model.CourseMaterials.OrderBy(cm => cm.Position);
                    foreach (var cm in sortedExisting)
                    {
                                <text>
                                            materialStagingQueue.push({
                                                title: "@Html.Raw(JavaScriptEncoder.Default.Encode(cm.Material.Title))",
                                                youTubeLink: "@Html.Raw(JavaScriptEncoder.Default.Encode(cm.Material.YouTubeLink))",
                                                position: @cm.Position
                                            });
                                </text>
                    }
        }
        renderStagingQueueView();
        toggleEditDomainInputFields();
    });

    function toggleEditDomainInputFields() {
        const dropdown = document.getElementById('editDomainSelectDropdown');
        const customWrapper = document.getElementById('customEditDomainInputWrapper');
        const customInput = document.getElementById('customEditDomainInput');

        if (dropdown && dropdown.value === '__CUSTOM__') {
            if (customWrapper) customWrapper.style.display = "block";
            if (customInput) customInput.focus();
        } else {
            if (customWrapper) customWrapper.style.display = "none";
            if (customInput) customInput.value = "";
        }
    }

    function prepareEditDomainPayload(event) {
        const dropdown = document.getElementById('editDomainSelectDropdown');
        const customInput = document.getElementById('customEditDomainInput');
        const fallbackInput = document.getElementById('customEditDomainInputNoDomains');
        const hiddenOutput = document.getElementById('finalEditDomainValue');

        let completeDomainStringValue = "";

        if (fallbackInput) {
            completeDomainStringValue = fallbackInput.value.trim();
        }
        else if (dropdown && dropdown.value === '__CUSTOM__') {
            completeDomainStringValue = customInput ? customInput.value.trim() : "";
            if (!completeDomainStringValue) {
                alert("⚠️ Please type a value name into the Custom New Domain field container.");
                event.preventDefault();
                return false;
            }
        }
        else if (dropdown) {
            completeDomainStringValue = dropdown.value;
        }

        hiddenOutput.value = completeDomainStringValue;
        return true;
    }

    function filterFacultyListGrid() {
        const query = document.getElementById('facultyLookupSearchBox').value.toLowerCase();
        const structuralCards = document.getElementsByClassName('faculty-checkbox-wrapper');

        for (let i = 0; i < structuralCards.length; i++) {
            const facultyName = structuralCards[i].getAttribute('data-name');
            structuralCards[i].style.display = facultyName.includes(query) ? "" : "none";
        }
    }

    function addMaterialToQueueRow() {
        const titleInput = document.getElementById('inputMaterialTitle');
        const urlInput = document.getElementById('inputMaterialUrl');
        const title = titleInput.value.trim();
        const url = urlInput.value.trim();

        if (!title || !url) {
            alert("⚠️ Provide both a distinct material layout title string and matching explicit reference URL path.");
            return;
        }

        materialStagingQueue.push({ title: title, youTubeLink: url, position: materialStagingQueue.length + 1 });
        titleInput.value = ''; urlInput.value = '';
        renderStagingQueueView();
    }

    /* DRAG AND DROP HANDLERS */
    function handleDragStart(ev, index) { currentlyDraggedIndex = index; ev.dataTransfer.effectAllowed = "move"; }
    function handleDragOver(ev, el) { ev.preventDefault(); el.classList.add('drag-over-active'); }
    function handleDragLeave(el) { el.classList.remove('drag-over-active'); }
    function handleDrop(ev, targetIndex, el) {
        el.classList.remove('drag-over-active');
        if (currentlyDraggedIndex === null || currentlyDraggedIndex === targetIndex) return;

        const interceptItem = materialStagingQueue.splice(currentlyDraggedIndex, 1)[0];
        materialStagingQueue.splice(targetIndex, 0, interceptItem);

        recalculateSequencePositions(); renderStagingQueueView();
    }
    function handleDragEnd() { currentlyDraggedIndex = null; }

    function moveItemUp(index) { if (index === 0) return; executeIndexSwap(index, index - 1); }
    function moveItemDown(index) { if (index === materialStagingQueue.length - 1) return; executeIndexSwap(index, index + 1); }
    function executeIndexSwap(idxA, idxB) {
        let temporaryPointer = materialStagingQueue[idxA];
        materialStagingQueue[idxA] = materialStagingQueue[idxB];
        materialStagingQueue[idxB] = temporaryPointer;
        recalculateSequencePositions(); renderStagingQueueView();
    }
    function removeStagedItemRow(index) { materialStagingQueue.splice(index, 1); recalculateSequencePositions(); renderStagingQueueView(); }
    function recalculateSequencePositions() { materialStagingQueue.forEach((item, idx) => { item.position = idx + 1; }); }

    function renderStagingQueueView() {
        const notice = document.getElementById('emptyQueueNotice');
        const holder = document.getElementById('liveVisualStagingQueueHolder');
        document.getElementById('queueCounterBadge').innerText = `${materialStagingQueue.length} Items`;

        if (materialStagingQueue.length === 0) { notice.style.display = "block"; holder.innerHTML = ''; return; }
        notice.style.display = "none";
        let trackingHtml = '';

        materialStagingQueue.forEach((item, index) => {
            const isFirst = index === 0; const isLast = index === materialStagingQueue.length - 1;
            trackingHtml += `
                <div class="list-group-item p-2 d-flex justify-content-between align-items-center position-relative syllabus-sortable-item"
                     draggable="true" ondragstart="handleDragStart(event, ${index})" ondragover="handleDragOver(event, this)" ondragleave="handleDragLeave(this)" ondrop="handleDrop(event, ${index}, this)" ondragend="handleDragEnd()">
                    <div class="d-flex align-items-center gap-2 overflow-hidden" style="max-width: 75%; user-select:none;">
                        <span class="text-muted opacity-50">☰</span>
                        <span class="badge bg-dark rounded-pill" style="font-size:0.7rem; min-width:24px;">#${item.position}</span>
                        <div class="text-truncate">
                            <h6 class="mb-0 fw-bold small text-dark text-truncate">${item.title}</h6>
                            <small class="text-muted d-block string-clip font-monospace" style="font-size:0.65rem;">${item.youTubeLink}</small>
                        </div>
                    </div>
                    <div class="item-control-actions d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-light border py-0 px-1 shadow-sm" onclick="event.stopPropagation(); moveItemUp(${index})" ${isFirst ? 'disabled style="opacity:0.2;"' : ''}>▲</button>
                        <button type="button" class="btn btn-sm btn-light border py-0 px-1 shadow-sm" onclick="event.stopPropagation(); moveItemDown(${index})" ${isLast ? 'disabled style="opacity:0.2;"' : ''}>▼</button>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 py-0 px-1 ms-1" onclick="event.stopPropagation(); removeStagedItemRow(${index})">❌</button>
                    </div>
                </div>`;
        });
        holder.innerHTML = trackingHtml;
    }

    function commitBulkStagedSyllabusToDatabase() {
        const targetBtn = document.getElementById('btnSubmitBulkSyllabus');
        targetBtn.disabled = true; targetBtn.innerText = "⏳ Saving curriculum sequence alignment...";

        fetch(`/Instructor/SaveBulkSyllabus`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ courseId: @Model.Id, materials: materialStagingQueue })
        })
        .then(response => {
            if (response.ok) {
                window.location.href = '@Url.Action("Dashboard", "Instructor")';
            } else {
                alert("❌ Database compilation step update error transaction failure.");
                targetBtn.disabled = false; targetBtn.innerText = "💾 Save Syllabus Sequence";
            }
        })
        .catch(err => {
            console.error(err);
            targetBtn.disabled = false; targetBtn.innerText = "💾 Save Syllabus Sequence";
        });
    }
</script>