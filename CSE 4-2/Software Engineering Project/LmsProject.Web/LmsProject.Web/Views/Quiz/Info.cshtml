@model LmsProject.Domain.Entities.Quiz

@{
    ViewData["Title"] = "Quiz Instructions";
    var isOpen = DateTime.UtcNow >= Model.AvailableFrom && DateTime.UtcNow <= Model.AvailableTo;
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-5 text-center">
            <h1 class="display-1 text-primary mb-3">📝</h1>
            <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>

            <p class="text-secondary mb-4" style="font-size: 1.1rem;">
                @Model.Description
            </p>

            <div class="row text-center mb-4 bg-light rounded-3 p-3 mx-2">
                <div class="col-6 border-end">
                    <h5 class="fw-bold text-dark mb-0">@Model.TimeLimitMinutes</h5>
                    <small class="text-muted fw-bold text-uppercase">Minutes</small>
                </div>
                <div class="col-6">
                    <h5 class="fw-bold text-dark mb-0">@Model.Questions.Count</h5>
                    <small class="text-muted fw-bold text-uppercase">Questions</small>
                </div>
            </div>

            <div class="alert alert-warning small fw-bold mb-4 text-start">
                ⚠️ IMPORTANT: Once you click start, the timer will begin. You cannot pause the timer, and you can only submit this assessment once.
            </div>

            @if (isOpen)
            {
                <a href="@Url.Action("Take", "Quiz", new { id = Model.Id })" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm py-3">
                    🚀 Start Assessment Now
                </a>
            }
            else if (DateTime.UtcNow < Model.AvailableFrom)
            {
                <button class="btn btn-secondary btn-lg w-100 fw-bold rounded-pill py-3" disabled>
                    Opens: @Model.AvailableFrom.ToString("MMM dd, yyyy HH:mm") UTC
                </button>
            }
            else
            {
                <button class="btn btn-danger btn-lg w-100 fw-bold rounded-pill py-3 opacity-75" disabled>
                    Time Window Closed
                </button>
            }

            <div class="mt-3">
                <a href="@Url.Action("Details", "Course", new { id = Model.CourseId })" class="text-muted small fw-bold text-decoration-none">← Return to Course</a>
            </div>
        </div>
    </div>
</div>